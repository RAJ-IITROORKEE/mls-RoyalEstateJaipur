# Public Supabase project values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only key, required only for trusted storage/admin operations
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional local operations token for `npm run supabase:auth-config` only.
# Create it under Supabase Account > Access Tokens. Never expose it to the browser.
SUPABASE_ACCESS_TOKEN=replace-with-personal-access-token

# One-time protected first-admin bootstrap. Never expose or commit real values.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-at-least-8-characters
ADMIN_BOOTSTRAP_NAME=Platform Administrator

# Supabase pooled runtime connection for Prisma queries
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection used by Prisma migration commands
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_NAME=RoyaleStateJaipur
NEXT_PUBLIC_BUSINESS_EMAIL=hello@example.com
NEXT_PUBLIC_BUSINESS_PHONE=+91 00000 00000
NEXT_PUBLIC_BUSINESS_WHATSAPP=910000000000

# Optional guarded demo seed. Use only with a real Supabase Auth user UUID.
SEED_DEMO_CONTENT=false
DEMO_OWNER_ID=
DEMO_OWNER_EMAIL=
